NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_APPSYNC_GRAPHQL_URL=
NEXT_PUBLIC_APPSYNC_REALTIME_URL=
NEXT_PUBLIC_S3_BUCKET=
GEMINI_API_KEY=

# Hazard workflow: local development runs with persistent .data/hazards.json.
# Explicit demo mode is only for a local demo; omit it on a live deployment.
HAZARD_DEMO_MODE=true
HAZARD_STORE_PATH=.data/hazards.json
HAZARD_GEMINI_MODEL=gemini-2.5-flash

# Live hazard deployment: Cognito above + PostgreSQL below, migration 002 required.
DATABASE_URL=
# Real shelters must be provisioned before first use; see docs/codearena26-setup.md.
HAZARD_SHELTERS_JSON=
# Public origin behind a TLS reverse proxy; leave blank for direct localhost development.
APP_URL=
# A managed/self-hosted OSRM base URL is required for production routing.
OSRM_BASE_URL=
